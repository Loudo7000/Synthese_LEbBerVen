--- !u!114 &189629379
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 189629377}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bienvenue dans mourir en VR. \r\nLe but du jeu est de r\xE9soudre les
    5 \xE9nigmes. \r\n\r\n- Generateur : Vous devez le remettre en fonction a l'aide
    de different outils.\n\r\n-Disjoncteur : Permet d'allumer les lumieres et d'ouvrir
    differentes portes inaccessibles au depart.\n\r\n- Engrenages :  Vous devez trouver
    3 engrenages afin de les ins\xE9rer dans une boite dissimule dans la carte. 
    \n\r\n- Code de couleurs : Vous devez entrer un code de 4 couleurs dans le bon
    ordre sur l'ordinateur.\nVous devez trouver plusieurs outils pour vous aider.\r\n\nUne
    fois terminee, quitter la scene par le tunnel du d\xE9part.\r\n\nLa lumiere vous
    guidera.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3f0448d8796d2244f99b0064d742bdbe, type: 2}
